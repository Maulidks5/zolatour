APP_NAME="Zola Tours & Safaris"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://zolatoursandsafaris.com
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=CPANEL_DATABASE_NAME
DB_USERNAME=CPANEL_DATABASE_USER
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=.zolatoursandsafaris.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.zolatoursandsafaris.com
MAIL_PORT=465
MAIL_USERNAME=info@zolatoursandsafaris.com
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS=info@zolatoursandsafaris.com
MAIL_FROM_NAME="Zola Tours & Safaris"
MAIL_ADMIN_ADDRESS=info@zolatoursandsafaris.com

VITE_APP_NAME="Zola Tours & Safaris"

ADMIN_NAME="Zola Tours Administrator"
ADMIN_EMAIL=info@zolatoursandsafaris.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_UNIQUE_PASSWORD
